.venv/
.claude/
__pycache__/
*.pyc
*.pyo
.DS_Store

# dados brutos — ignorar tudo, manter estrutura via .gitkeep
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/default/
/data/raw/default/*
!/data/raw/default/.gitkeep
!/data/raw/motor_uniform/
/data/raw/motor_uniform/*
!/data/raw/motor_uniform/.gitkeep

# temporários FEMM e NPZ intermediários
/data/temp/*
!/data/temp/.gitkeep
!/data/temp/samples_npz/
/data/temp/samples_npz/*
!/data/temp/samples_npz/.gitkeep
!/data/temp/samples_npz/default/
/data/temp/samples_npz/default/*
!/data/temp/samples_npz/default/.gitkeep
!/data/temp/samples_npz/motor_uniform/
/data/temp/samples_npz/motor_uniform/*
!/data/temp/samples_npz/motor_uniform/.gitkeep

# chunks de treino — ignorar tudo, manter estrutura via .gitkeep
/data/torch/quad_chunks/*
