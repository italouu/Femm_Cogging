!/data/torch/data_chunks/motor_default_v4_135x270/.gitkeep

# modelos de rede — ignorar pesos, manter estrutura via .gitkeep
/data/models/*
!/data/models/.gitkeep
!/data/models/default/
/data/models/default/*
!/data/models/default/.gitkeep

# dados externos — ignorar conteúdo, manter estrutura via .gitkeep
/data/external/*
