.venv/
.claude/
.vscode/
__pycache__/
*.pyc
*.pyo
.DS_Store

# dados brutos — ignorar tudo, manter estrutura via .gitkeep
/data/raw/*
!/data/raw/.gitkeep

# temporários (FEMM, parse do .ans, testes de equivalência)
/data/temp/*
!/data/temp/.gitkeep

# chunks de treino — ignorar tudo, manter estrutura via .gitkeep
/data/torch/data_chunks/*
!/data/torch/data_chunks/.gitkeep

# logs de treino — ignorar runs (checkpoints .pth, metrics), manter estrutura via .gitkeep
/data/logs/*
!/data/logs/.gitkeep

# dados de terceiros antigos (Darcy), só locais — sem uso no pipeline
/data/external/

CLAUDE.md
tests

# backup local dos logs da bateria antiga (1,1 GB) — nunca versionar (limite de 100 MB do GitHub)
old_logs.tar

# pós-processamento: figuras fora do git (só os dados ficam versionados)
/resultados/*/plots/
